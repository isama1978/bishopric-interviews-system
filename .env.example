# Copiá este archivo a .env.local y completá los valores.
# NUNCA subas .env.local ni pongas valores reales en este archivo.

# --- Base de datos (Neon) ---
# Conexión con pooler: la usa la aplicación en ejecución.
DATABASE_URL=
# Conexión directa: la usan las migraciones de Prisma.
DIRECT_URL=

# --- Secretos (generar cada uno con: openssl rand -base64 32) ---
# Clave de cifrado AES-256-GCM para teléfonos, correos y secretos TOTP.
APP_ENCRYPTION_KEY=
# Firma de los enlaces personales de los miembros (HMAC).
MEMBER_LINK_SECRET=
# Firma de las claves de coincidencia del padrón (HMAC).
MEMBER_MATCH_SECRET=
# Firma y protección de las sesiones del personal.
SESSION_SECRET=